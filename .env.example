# Copy these into your host's "Environment Variables" screen. All are optional.
APP_PASSWORD=choose-a-team-password
PUBLIC_URL=https://your-app.example.com

# Email option A: any SMTP provider (Gmail app password, Brevo, Mailgun, Zoho, Office 365...)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM="Process Safety Tracker <you@example.com>"

# Email option B: Resend (https://resend.com, free tier)
# RESEND_API_KEY=re_xxx
# MAIL_FROM="Process Safety Tracker <alerts@yourdomain.com>"

# Where data + uploads live in file mode (no DATABASE_URL). Point at a persistent disk/volume on your host.
# DATA_DIR=/data
# SEED_DEMO=false

# Durable storage (recommended). Any Postgres works — e.g. a free Neon database:
#   1. Sign up at https://neon.tech, create a project, copy the pooled connection string.
#   2. Set DATABASE_URL here. Tables (app_state, docs_store) are created automatically on first boot.
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
