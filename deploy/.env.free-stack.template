# ────────────────────────────────────────────────────────────────
# ps-tracker — free-stack environment template
# Copy to /opt/ps-tracker/.env and fill in the marked values.
# This file intentionally contains no real credentials.
# ────────────────────────────────────────────────────────────────

# ── App core ──────────────────────────────────────────────────
APP_PASSWORD=choose-a-team-password          # REQUIRED: login is disabled without it
PUBLIC_URL=https://your-box.hyper.host        # your Vibe Hosting HTTPS subdomain (digest email links)

# Wire-protocol paths and port.
# Docker (Option A): keep DATA_DIR=/data (matches Dockerfile + volume mount).
# PM2/Option B:     change to  DATA_DIR=/opt/ps-tracker-data
DATA_DIR=/data
PORT=8080
TZ=Africa/Lagos
SEED_DEMO=false                # true only if you want demo seed data on first boot
# CORS_ORIGIN=https://ps-tracker  # only if you embed the app elsewhere; default *

# ── Email, Option A: Brevo SMTP (9,000 emails/mo free) ───────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<your-brevo-account-email>
SMTP_PASS=<brevo-smtp-key>                     # Brevo → SMTP & API → Generate key
MAIL_FROM="Process Safety Tracker <you@yourdomain.com>"

# ── Email, Option B: Resend API (3,000 emails/mo free) ───────
# Comment out the Brevo block above if using Resend.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# MAIL_FROM="Process Safety Tracker <alerts@yourdomain.com>"

# ── Notes ─────────────────────────────────────────────────────
# • server.js logs /api/health as: {"ok":true,"auth":true,"email":{"smtp":true,"resend":false}}
# • webhook delivery (Discord/Slack) is configured inside the app UI
#   (Settings → webhook URL) — no env var needed.
